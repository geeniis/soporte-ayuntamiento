// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-x64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Status {
  pendiente
  en_progreso
  resuelto
  cerrado
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  nombre    String?
  password  String
  role      String   @default("user")
  creadoEn  DateTime @default(now())
  tickets   Ticket[] @relation("AuthorTickets")
  assigned  Ticket[] @relation("AssignedTickets")
  comments  Comment[]
}

model Ticket {
  id          Int      @id @default(autoincrement())
  titulo      String
  descripcion String
  estado      Status   @default(pendiente)
  imagen      String?
  creadoEn    DateTime @default(now())

  authorId     Int?
  author       User?    @relation("AuthorTickets", fields: [authorId], references: [id])
  assignedToId Int?
  assignedTo   User?    @relation("AssignedTickets", fields: [assignedToId], references: [id])

  comments    Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  contenido String
  creadoEn  DateTime @default(now())

  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])

  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id])
}